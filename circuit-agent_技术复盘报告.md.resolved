### 核心模块划分

```
后端 src/main/java/com/eric/ekaiagent/
├── agent/          # Agent 核心执行引擎（最重要）
│   ├── BaseAgent        # 状态机 + 步骤循环控制
│   ├── ReActAgent       # Think/Act 抽象
│   ├── ToolCallAgent    # LLM → 工具调用执行
│   └── EkManus          # 具体 Agent 实例（System Prompt + 工具绑定）
├── app/            # 应用层（面向具体场景）
│   └── AlgorithmApp     # RAG + 多轮对话 + 工具调用的综合入口
├── controller/     # HTTP 接入层
│   └── AiController     # REST + SSE 路由分发
├── tools/          # Agent 工具包（可扩展）
│   ├── WebSearchTool    # Baidu 搜索
│   ├── WebScrapingTool  # 网页爬取（Jsoup）
│   ├── FileOperationTool# 文件读写
│   ├── TerminalOperationTool # 终端命令执行（⚠️ 高危）
│   ├── PDFGenerationTool# PDF 生成
│   ├── ResourceDownloadTool # 资源下载
│   └── TerminateTool    # Agent 终止信号
├── rag/            # RAG 管道
│   ├── AlgorithmAppDocumentLoader    # Markdown → Document
│   ├── AlgorithmAppVectorStoreConfig # 向量存储初始化（SimpleVectorStore）
│   ├── PgVectorVectorStoreConfig     # PgVector 配置（已注释）
│   ├── MyKeywordEnricher             # 关键词元数据增强
│   ├── MyTokenTextSplitter           # 自定义分词（已注释）
│   ├── QueryRewriter                 # 查询重写（RewriteQueryTransformer）
│   ├── AlgorithmAppRagCustomAdvisorFactory # 自定义 RAG Advisor
│   └── AlgorithmAppRagCloudAdvisorConfig   # 云知识库 Advisor（已注释）
├── advisors/       # 拦截器/观察器
│   ├── MyLoggerAdvisor  # 请求/响应日志
│   └── ReReadingAdvisor # Re-Reading 提示增强（已注释）
├── chatmemory/     # 会话记忆自定义实现
│   └── FileBasedChatMemory # Kryo 序列化到磁盘
├── config/         # 基础设施配置
│   └── CorsConfig       # 跨域配置
└── demo/           # 实验性代码（不在主链路）
    └── invoke/     # 5种LLM调用方式对比（HTTP/SDK/SpringAI/LangChain/Ollama）
```

